# Copy to .env and fill in. The project must be in a Copilot-harness region (e.g. Sweden Central, East US, Canada Central).
AZURE_SUBSCRIPTION_ID=<your-subscription-id>
AZURE_RESOURCE_GROUP=<your-resource-group>
FOUNDRY_ACCOUNT=<your-foundry-resource-name>
FOUNDRY_PROJECT=<your-foundry-project-name>
MODEL_DEPLOYMENT=gpt-6.1-terra
